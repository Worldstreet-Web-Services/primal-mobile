# Copy to `.env.local` (gitignored) and fill in.
#
# Everything here is EXPO_PUBLIC_*, which Expo inlines into the JS bundle at
# build time. Treat every value as readable by anyone with the app.
#
# Any value left unset falls back to mock data so the app stays runnable
# (see `usingMockApi` in src/lib/api.ts and `usingMockAuth` in
# src/lib/auth/decane.ts).

# primal-be base URL. Unset => the API layer returns mock data.
EXPO_PUBLIC_API_URL=

# Decane project id: dashboard -> API Keys -> App ID.
EXPO_PUBLIC_DECANE_APP_ID=

# Decane API key (dck_live_… / dck_test_…).
#
# The native SDK takes this client-side, so unlike the web SDK it DOES ship in
# the bundle and can be extracted from the binary. That is by design — what
# actually constrains it is the key's `callback_url` in the dashboard, which
# must be exactly `kashplus://auth` (matching `scheme` in app.json). The
# backend redirects only to that registered value, never one passed at runtime.
EXPO_PUBLIC_DECANE_API_KEY=

# WebAuthn relying-party ID — a domain you control, e.g. app.kashplus.example.
#
# Required for the passkey unlock tier. There is NO default on native, and if
# it is unset the SDK silently falls back to the secure-enclave tier: no error,
# no passkey sign-in. It must also be backed by associated domains —
# apple-app-site-association (iOS) and assetlinks.json (Android) — see
# docs/decane-auth.md.
EXPO_PUBLIC_DECANE_RP_ID=

# ---------------------------------------------------------- development only
#
# Every flag below is inert outside `__DEV__` — see src/lib/devMode.ts.

# Run the identity stack against stand-ins: sign-in mints a placeholder wallet
# instead of calling Decane, and every gateway request is answered on-device by
# src/lib/gateway/placeholder.ts. The app then walks its REAL onboarding
# sequence — sign in, PIN, biometric unlock, payment, welcome aboard — with no
# backend reachable at all.
#
# Defaults ON in a dev build whenever the Decane credentials above are unset,
# because without them the SDK cannot initialise and the app cannot get past
# its first screen. Set to 0 to refuse the fallback and see the real failure.
EXPO_PUBLIC_DEV_PLACEHOLDER_AUTH=

# How long the placeholder payment takes to settle, in milliseconds (default
# 12000). It moves AWAITING_TRANSFER -> PROCESSING -> SETTLED over this window,
# which is long enough for the checkout screen to poll and show each state.
EXPO_PUBLIC_DEV_PLACEHOLDER_SETTLE_MS=

# Walk past the membership gate without paying. NOTE this skips the payment
# step entirely, so leave it unset when the point is to walk the whole flow.
# Against the real gateway it buys nothing behind the gate either — every
# /v1/linkpay/* route still answers 403.
EXPO_PUBLIC_DEV_SKIP_PAYWALL=

# How long the app may be OFF SCREEN before it locks itself (ms) — backgrounded,
# switched away from, or frontmost on a locked phone. Time with the app open is
# never counted, however idle. Development only: production is a fixed two
# minutes and no environment value can widen it. Unset means one minute here;
# anything below a minute is clamped up to one, because a mistyped `0` locks on
# every glance at another app and reads as a crash loop.
EXPO_PUBLIC_DEV_LOCK_AFTER_MS=

# Fill the home screen's Recent Transaction card with invented sample rows.
EXPO_PUBLIC_DEV_SAMPLE_ACTIVITY=

# A fixed wallet for a checkout's `refundTo` when Decane has no address yet.
# Ignored whenever a real wallet address exists, and outside __DEV__.
EXPO_PUBLIC_DEV_REFUND_ADDRESS=
