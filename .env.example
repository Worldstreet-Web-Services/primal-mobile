# Copy to `.env.local` (gitignored) and fill in.
#
# Everything here is EXPO_PUBLIC_*, which Expo inlines into the JS bundle at
# build time. Treat every value as readable by anyone with the app.
#
# Any value left unset falls back to mock data so the app stays runnable
# (see `usingMockApi` in src/lib/api.ts and `usingMockAuth` in
# src/lib/auth/decane.ts).

# primal-be base URL. Unset => the API layer returns mock data.
EXPO_PUBLIC_API_URL=

# Decane project id: dashboard -> API Keys -> App ID.
EXPO_PUBLIC_DECANE_APP_ID=

# Decane API key (dck_live_… / dck_test_…).
#
# The native SDK takes this client-side, so unlike the web SDK it DOES ship in
# the bundle and can be extracted from the binary. That is by design — what
# actually constrains it is the key's `callback_url` in the dashboard, which
# must be exactly `paradigm://auth` (matching `scheme` in app.json). The
# backend redirects only to that registered value, never one passed at runtime.
EXPO_PUBLIC_DECANE_API_KEY=

# WebAuthn relying-party ID — a domain you control, e.g. app.paradigm.example.
#
# Required for the passkey unlock tier. There is NO default on native, and if
# it is unset the SDK silently falls back to the secure-enclave tier: no error,
# no passkey sign-in. It must also be backed by associated domains —
# apple-app-site-association (iOS) and assetlinks.json (Android) — see
# docs/decane-auth.md.
EXPO_PUBLIC_DECANE_RP_ID=
