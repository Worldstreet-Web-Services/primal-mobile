# Copy to `.env.local` (gitignored) and fill in.
#
# Everything here is EXPO_PUBLIC_*, which Expo inlines into the JS bundle at
# build time. Treat every value below as readable by anyone with the app —
# never put a secret in this file.
#
# Any value left unset falls back to mock data so the app stays runnable
# (see `usingMockApi` in src/lib/api.ts and `usingMockAuth` in
# src/lib/auth/decane.ts).

# primal-be base URL. Unset => the API layer returns mock data.
EXPO_PUBLIC_API_URL=

# Our hosted Decane auth surface — the web page running decane-connect-kit.
# Required because the SDK is web-only and cannot run in React Native.
# Unset => sign-in resolves locally with a visibly fake token.
EXPO_PUBLIC_AUTH_URL=

# Decane project id: dashboard -> API Keys -> App ID.
# Public by design (an audience identifier, not a secret).
EXPO_PUBLIC_DECANE_APP_ID=

# NOTE: the Decane API key (dck_live_… / dck_test_…) does NOT belong here.
# It is consumed by the hosted auth surface, server-side, and is protected by
# an origin allowlist — shipping it in the mobile bundle would expose it to
# anyone who unpacks the app.
